# normalize line endings for anything git detects as text
* text=auto

# binary assets: no eol conversion, no text diffs, no merge attempts
*.jpg   binary
*.jpeg  binary
*.png   binary
*.webp  binary
*.gif   binary
*.ico   binary
*.svg   text
*.ogg   binary
*.mp3   binary
*.woff  binary
*.woff2 binary

# generated at build time: keep them out of diffs and language stats
public/changelog.json     -diff linguist-generated
public/blog-manifest.json -diff linguist-generated
bun.lock                  -diff linguist-generated
